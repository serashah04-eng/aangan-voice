# Copy to .env.local. Never commit real values. All secrets are read server-side only.
# Phase 1 (rules engine + tests) needs none of these.

# --- Versioning -------------------------------------------------------------
# Rules version stamped on every criterion_evidence row. Vercel sets VERCEL_GIT_COMMIT_SHA automatically.
RULES_VERSION=

# --- Phase 2: extraction / dialogue ------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=

# --- Phase 3: data + integrations --------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key: server-side only, never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=
HUBSPOT_PRIVATE_APP_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_DESIGNER_CHAT_ID=
TELEGRAM_STUDIO_HEAD_CHAT_ID=
RESEND_API_KEY=
RESEND_FROM=
DESIGNER_FALLBACK_EMAIL=
STUDIO_HEAD_EMAIL=
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
# Studio inbox used as the Cal.com attendee email (we never collect email on calls — Q27).
CALENDAR_ATTENDEE_EMAIL=
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
APP_BASE_URL=
CRON_SECRET=

# --- Phase 4: voice (Vaani Labs) ---------------------------------------------
VAANI_API_KEY=
VAANI_WEBHOOK_SECRET=
